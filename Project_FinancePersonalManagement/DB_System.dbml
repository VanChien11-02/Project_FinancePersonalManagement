      <Column Name="AccountName" Type="System.String" DbType="NVarChar(100) NOT NULL" CanBeNull="false" />
      <Column Name="Balance" Type="System.Decimal" DbType="Decimal(18,2)" CanBeNull="true" />
      <Column Name="AccountType" Type="System.String" DbType="NVarChar(50)" CanBeNull="true" />
      <Column Name="BankDetail" Type="System.String" DbType="NVarChar(200)" CanBeNull="true" />
      <Association Name="Account_Transaction" Member="Transactions" ThisKey="AccountID" OtherKey="AccountID" Type="Transaction" />
      <Association Name="Account_Debt" Member="Debts" ThisKey="AccountID" OtherKey="AccountID" Type="Debt" />
      <Association Name="User_Account" Member="User" ThisKey="UserID" OtherKey="UserID" Type="User" IsForeignKey="true" />
    </Type>
  </Table>
  <Table Name="dbo.Budgets" Member="Budgets">
