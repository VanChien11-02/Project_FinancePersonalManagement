      <Association Name="Category_Transaction" Member="Category" ThisKey="CategoryID" OtherKey="CategoryID" Type="Category" IsForeignKey="true" />
      <Association Name="User_Transaction" Member="User" ThisKey="UserID" OtherKey="UserID" Type="User" IsForeignKey="true" />
